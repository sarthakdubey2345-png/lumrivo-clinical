# Copy this file to .env for Docker Compose. Never commit the real .env.
# Generate APP_SECRET with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# This initial password is used ONLY when a database is first created.
# Choose a unique password at least 16 characters long. Do not retain this placeholder.
DEMO_PASSWORD=REPLACE_WITH_A_UNIQUE_INITIAL_PASSWORD
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe
DOCUMENT_MODEL=gpt-4.1-mini
